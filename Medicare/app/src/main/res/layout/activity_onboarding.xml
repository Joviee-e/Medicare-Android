<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header toolbar -->
    <TextView
        android:id="@+id/txt_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MediCare+"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/btn_skip_onboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip All"
        android:textColor="@color/neutral_gray"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/txt_app_name"
        app:layout_constraintBottom_toBottomOf="@id/txt_app_name"/>

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/progress_steps"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:max="100"
        android:progress="25"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/txt_app_name" />

    <TextView
        android:id="@+id/txt_step_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 1 OF 4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.1"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="@id/progress_steps"
        app:layout_constraintTop_toBottomOf="@id/progress_steps" />

    <TextView
        android:id="@+id/txt_step_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Basic Information"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="@id/progress_steps"
        app:layout_constraintTop_toBottomOf="@id/txt_step_indicator" />

    <!-- Container for scrollable form steps -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/txt_step_title"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- STEP 1: Basic Info -->
            <LinearLayout
                android:id="@+id/step_basic_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE NUMBER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/btn_ob_phone_country"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_input_selector"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="🇮🇳 +91"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <EditText
                        android:id="@+id/input_ob_phone"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:hint="enter phone number"
                        android:textColorHint="@color/neutral_gray"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_input_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="phone"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE OF BIRTH (DD-MM-YYYY)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/input_ob_dob"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:hint="select or enter birth date"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/input_ob_age"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:hint="enter your age"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="number"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GENDER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <RadioGroup
                    android:id="@+id/rg_ob_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_gender_male"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Male"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rb_gender_female"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Female"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rb_gender_other"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Other"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

            </LinearLayout>

            <!-- STEP 2: Medical Details -->
            <LinearLayout
                android:id="@+id/step_medical_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOOD GROUP"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:id="@+id/layout_ob_blood_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/chip_blood_o_pos"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="O+"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_o_neg"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="O-"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_a_pos"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="A+"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_a_neg"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="A-"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/chip_blood_b_pos"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="B+"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_b_neg"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="B-"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_ab_pos"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="AB+"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/chip_blood_ab_neg"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="AB-"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALLERGIES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/input_ob_allergies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Penicillin, Peanuts (or None)"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXISTING CONDITIONS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/input_ob_conditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Asthma, Hypertension (or None)"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT MEDICATIONS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/input_ob_medications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Albuterol inhaler (or None)"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- STEP 3: Emergency Contacts -->
            <LinearLayout
                android:id="@+id/step_emergency_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY CONTACT NAME"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/input_ob_emerg_name"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:hint="enter contact name"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textPersonName"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RELATIONSHIP"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <Spinner
                    android:id="@+id/spinner_ob_emerg_rel"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY PHONE NUMBER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/btn_ob_emerg_phone_country"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_input_selector"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="🇮🇳 +91"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <EditText
                        android:id="@+id/input_ob_emerg_phone"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:hint="enter emergency phone"
                        android:textColorHint="@color/neutral_gray"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_input_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="phone"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- STEP 4: Address Details -->
            <LinearLayout
                android:id="@+id/step_address_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESIDENTIAL ADDRESS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/input_ob_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_marginTop="6dp"
                    android:hint="enter your home address"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="15sp" />

            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom buttons navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_ob_skip"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Do This Later"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_ob_next"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Continue"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_onboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/primary"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
