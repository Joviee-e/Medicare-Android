<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/btn_back_to_login"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/primary" />

            <!-- Header Title -->
            <TextView
                android:id="@+id/lbl_reset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_back_to_login" />

            <TextView
                android:id="@+id/txt_reset_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow the steps to securely recover your account credentials."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lbl_reset_title" />

            <!-- STEP 1 Layout: Request Reset Code -->
            <LinearLayout
                android:id="@+id/layout_step_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/txt_reset_subtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/input_reset_email"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:hint="enter your email"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btn_send_code"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="Send Reset Code"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- STEP 2 Layout: Verify Reset Code & Set Password -->
            <LinearLayout
                android:id="@+id/layout_step_verify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/txt_reset_subtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6-DIGIT VERIFICATION CODE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/input_verification_code"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:hint="enter 6-digit code"
                    android:textColorHint="@color/neutral_gray"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEW PASSWORD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/primary">

                    <EditText
                        android:id="@+id/input_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="enter new password"
                        android:textColorHint="@color/neutral_gray"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_input_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIRM NEW PASSWORD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/primary">

                    <EditText
                        android:id="@+id/input_confirm_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:hint="re-enter new password"
                        android:textColorHint="@color/neutral_gray"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_input_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_reset_submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="Reset Password"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Navigation back link -->
            <TextView
                android:id="@+id/btn_goto_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Return to Sign In"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:layout_marginTop="36dp"
                android:padding="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_step_request" />

            <ProgressBar
                android:id="@+id/progress_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/primary"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
