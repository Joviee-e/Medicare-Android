<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Top Header Bar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/avatar_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <!-- Mock Elder avatar -->
                <ImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile_filled"
                    android:scaleType="centerCrop"
                    android:tint="@color/on_secondary_container"
                    android:background="@color/secondary_container"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txt_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MediCare+"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                app:layout_constraintLeft_toRightOf="@id/avatar_container"
                app:layout_constraintTop_toTopOf="@id/avatar_container"
                app:layout_constraintBottom_toBottomOf="@id/avatar_container"/>

            <ImageView
                android:id="@+id/btn_notification"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/avatar_container"
                app:layout_constraintBottom_toBottomOf="@id/avatar_container"/>

            <!-- Greeting section -->
            <TextView
                android:id="@+id/txt_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good Morning, Sarah"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/avatar_container"/>

            <TextView
                android:id="@+id/txt_subgreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Here is your health overview for today."
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/txt_greeting"/>

            <!-- Daily Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/txt_subgreeting">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txt_progress_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Progress"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You're doing great!"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txt_progress_title"/>

                    <!-- Custom Progress Ring Container -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.example.medicare.CircularProgressView
                            android:id="@+id/circular_progress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_gravity="center">

                            <TextView
                                android:id="@+id/txt_progress_fraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 / 4"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Taken"
                                android:textSize="10sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming header -->
            <TextView
                android:id="@+id/txt_header_upcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_progress"/>

            <!-- Upcoming Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/secondary_container"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/txt_header_upcoming">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/pill_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/secondary_container"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pill"
                            android:layout_gravity="center"
                            app:tint="@color/primary"/>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_upcoming_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Metformin"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="14dp"
                        app:layout_constraintLeft_toRightOf="@id/pill_bg"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@id/pill_bg"/>

                    <TextView
                        android:id="@+id/txt_upcoming_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="500mg • Take with food"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintLeft_toRightOf="@id/pill_bg"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txt_upcoming_name"/>

                    <!-- Time & Badge -->
                    <LinearLayout
                        android:id="@+id/layout_upcoming_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="14dp"
                        app:layout_constraintLeft_toRightOf="@id/pill_bg"
                        app:layout_constraintTop_toBottomOf="@id/txt_upcoming_desc">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/status_taken"/>

                        <TextView
                            android:id="@+id/txt_upcoming_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:00 AM"
                            android:textColor="@color/status_taken"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"/>

                        <TextView
                            android:id="@+id/txt_upcoming_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In 30 min"
                            android:textSize="12sp"
                            android:textColor="@color/status_taken"
                            android:background="@drawable/bg_status_taken"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="10dp"
                            android:gravity="center"/>
                    </LinearLayout>

                    <View
                        android:id="@+id/upcoming_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_upcoming_time"/>

                    <!-- Take Now Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_take_now"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Take Now"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_check_circle"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        android:backgroundTint="@color/primary"
                        app:cornerRadius="8dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/upcoming_divider"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Schedule header -->
            <TextView
                android:id="@+id/txt_header_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Schedule"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_upcoming"/>

            <TextView
                android:id="@+id/btn_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/txt_header_schedule"
                app:layout_constraintBottom_toBottomOf="@id/txt_header_schedule"/>

            <!-- Schedule Card containing List -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_schedule_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/txt_header_schedule"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_schedule"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Master Bottom Navigation bar -->
    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>