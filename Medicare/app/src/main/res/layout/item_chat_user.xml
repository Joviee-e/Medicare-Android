<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chat_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txt_chat_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User message here..."
            android:textSize="15sp"
            android:textColor="@color/white"
            android:padding="12dp"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txt_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:42 AM"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintRight_toRightOf="@id/chat_bubble"
        app:layout_constraintTop_toBottomOf="@id/chat_bubble"/>

</androidx.constraintlayout.widget.ConstraintLayout>
