<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Medicare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#4DD0E1</item>
        <item name="colorPrimaryContainer">#004D56</item>
        <item name="android:statusBarColor">#0F1416</item>
        <item name="android:windowBackground">#121516</item>

        <!-- Adaptive Material Dialog & Picker Themes -->
        <item name="android:datePickerDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Medicare.Dialog</item>
    </style>

    <!-- Dialog theme for dark mode with high-contrast buttons -->
    <style name="Theme.Medicare.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#4DD0E1</item>
        <item name="android:colorPrimary">#4DD0E1</item>
    </style>

</resources>