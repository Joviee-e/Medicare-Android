<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Medicare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Adaptive Material Dialog & Picker Themes -->
        <item name="android:datePickerDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Medicare.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Medicare.Dialog</item>
    </style>

    <!-- Dialog theme for light mode -->
    <style name="Theme.Medicare.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
    </style>

</resources>